<?xml version="1.0" encoding="UTF-8"?><project-modules id="moduleCoreId" project-version="1.5.0">
                
    
    
    <wb-module deploy-name="egov-egi">
                                
        
        
        <wb-resource deploy-path="/" source-path="/src/main/java"/>
                                
        
        
        <wb-resource deploy-path="/" source-path="/src/main/resources"/>

        <!-- Publish compiled utility-module classes into the exploded EAR.
             Without this mapping, Eclipse creates an empty egov-egi JAR
             directory and WildFly cannot load the web filters. -->
